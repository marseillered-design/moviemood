{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/tmdb/:path*",
      "destination": "https://api.themoviedb.org/3/:path*"
    },
    {
      "source": "/tmdb-img/:path*",
      "destination": "https://image.tmdb.org/t/p/:path*"
    },
    {
      "source": "/moods",
      "destination": "/api/page?kind=moods"
    },
    {
      "source": "/moods/:slug",
      "destination": "/api/page?kind=mood&slug=:slug"
    },
    {
      "source": "/movie/:id",
      "destination": "/api/page?kind=title&type=movie&id=:id"
    },
    {
      "source": "/tv/:id",
      "destination": "/api/page?kind=title&type=tv&id=:id"
    },
    {
      "source": "/person/:id",
      "destination": "/api/page?kind=person&id=:id"
    },
    {
      "source": "/:lang(uk|ru|fr|es|de)",
      "destination": "/api/page?kind=home&lang=:lang"
    },
    {
      "source": "/:lang(uk|ru|fr|es|de)/moods",
      "destination": "/api/page?kind=moods&lang=:lang"
    },
    {
      "source": "/:lang(uk|ru|fr|es|de)/moods/:slug",
      "destination": "/api/page?kind=mood&slug=:slug&lang=:lang"
    },
    {
      "source": "/:lang(uk|ru|fr|es|de)/movie/:id",
      "destination": "/api/page?kind=title&type=movie&id=:id&lang=:lang"
    },
    {
      "source": "/:lang(uk|ru|fr|es|de)/tv/:id",
      "destination": "/api/page?kind=title&type=tv&id=:id&lang=:lang"
    },
    {
      "source": "/:lang(uk|ru|fr|es|de)/person/:id",
      "destination": "/api/page?kind=person&id=:id&lang=:lang"
    },
    {
      "source": "/movies-like/:id",
      "destination": "/api/page?kind=like&type=movie&id=:id"
    },
    {
      "source": "/shows-like/:id",
      "destination": "/api/page?kind=like&type=tv&id=:id"
    },
    {
      "source": "/:lang(uk|ru|fr|es|de)/movies-like/:id",
      "destination": "/api/page?kind=like&type=movie&id=:id&lang=:lang"
    },
    {
      "source": "/:lang(uk|ru|fr|es|de)/shows-like/:id",
      "destination": "/api/page?kind=like&type=tv&id=:id&lang=:lang"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/page?kind=sitemap"
    },
    {
      "source": "/sitemap/:part.xml",
      "destination": "/api/page?kind=sitemap&part=:part"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/page?kind=robots"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|svg|ico|webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
