// MovieMood on Cloudflare Workers (see worker.js). Deploy: npx wrangler deploy
{
  "name": "moviemood",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  // process.env in api/page.js and api/mood.js (TMDB_API_KEY, GROQ_API_KEY, GROQ_MODEL)
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // files are served at their own names (/feed.html stays /feed.html); the rest goes to worker.js
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // the test address moviemood.moviemood.workers.dev stays on
  "workers_dev": true,
  // both addresses answer from this Worker; the bare one redirects to www (worker.js)
  "routes": [
    { "pattern": "www.themoviemood.com", "custom_domain": true },
    { "pattern": "themoviemood.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
